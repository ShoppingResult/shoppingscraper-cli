{
  "name": "@shoppingscraper/cli",
  "version": "0.1.0",
  "description": "Price scraper CLI for Amazon, Google Shopping, Bol.com, and Coolblue. Scrape prices, offers, buy-box, variants, and reviews from your terminal. Stable JSON envelope, MCP server for Claude Desktop / Cursor / Code, ships with a SKILL.md.",
  "keywords": [
    "price-scraper",
    "price-scraper-cli",
    "price-scraper-tool",
    "scrap-price",
    "shopping-scraper",
    "shoppingscraper",
    "google-shopping-scraper",
    "amazon-price-scraper",
    "ecommerce-scraper",
    "ecommerce-price-scraper",
    "ecommerce-data-scraping",
    "ecommerce-scraper-cli",
    "price-monitoring",
    "price-monitoring-cli",
    "price-tracking",
    "price-comparison-api",
    "buybox",
    "buybox-scraper",
    "ean-lookup",
    "gtin-api",
    "bol",
    "coolblue",
    "cli",
    "scraper",
    "scraping",
    "scraping-api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "homepage": "https://github.com/ShoppingResult/shoppingscraper-cli#readme",
  "bugs": "https://github.com/ShoppingResult/shoppingscraper-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShoppingResult/shoppingscraper-cli.git"
  },
  "license": "MIT",
  "author": "ShoppingScraper",
  "type": "module",
  "bin": {
    "ssc": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "undici": "^6.21.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
